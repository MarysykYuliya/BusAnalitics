@model BusinessAnalytics.Models.Entities.ProductCategory
@{
    ViewData["Title"] = "Додати категорію";
    var businessId = ViewBag.BusinessId;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="page-title mb-1">@ViewData["Title"]</h2>
        <p class="text-muted">Створіть нову категорію для товарів та послуг.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-5">
            <form asp-action="Create" method="post">
                <input type="hidden" name="businessId" value="@businessId" />
                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Назва категорії <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Гарячі напої" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Description" class="form-label">Опис</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Додаткова інформація..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-4" style="border-top: 1px solid rgba(255,255,255,0.05);">
                    <a asp-action="Index" asp-route-businessId="@businessId" class="btn-modern px-4">
                        Скасувати
                    </a>
                    <button type="submit" class="btn-modern btn-modern-primary px-5">
                        <i class="bi bi-check-circle me-2"></i> Створити
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
