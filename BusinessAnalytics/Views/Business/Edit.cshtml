@model BusinessAnalytics.Models.Entities.BusinessAccount
@{
    ViewData["Title"] = "Редагувати бізнес";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="page-title mb-1">@ViewData["Title"]</h2>
        <p class="text-muted">Оновіть інформацію про вашу компанію.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-5">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="OwnerId" />
                
                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Назва бізнесу <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Опис бізнесу</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label">Адреса</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label">Контактна особа</label>
                        <input asp-for="ContactPerson" class="form-control" />
                        <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="RegistrationCode" class="form-label">Код ЄДРПОУ / ІПН</label>
                    <input asp-for="RegistrationCode" class="form-control" />
                    <span asp-validation-for="RegistrationCode" class="text-danger small"></span>
                </div>

                <div class="mb-5">
                    <label class="form-label">Логотип бізнесу</label>
                    <div class="p-4 rounded-3 text-center" style="background: rgba(0, 255, 136, 0.05); border: 1px dashed rgba(0, 255, 136, 0.3);">
                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <div class="mb-3">
                                <img src="@Model.LogoPath" alt="Current Logo" class="img-thumbnail bg-transparent border-secondary" style="max-height: 100px;" />
                            </div>
                        }
                        <input type="file" name="logoFile" class="form-control mb-2" accept="image/*" />
                        <small class="text-muted">Залиште пустим, щоб зберегти поточний логотип. Макс. розмір 2MB.</small>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 pt-4" style="border-top: 1px solid rgba(255,255,255,0.05);">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn-modern px-4">
                        Скасувати
                    </a>
                    <button type="submit" class="btn-modern btn-modern-primary px-5">
                        <i class="bi bi-save me-2"></i> Зберегти
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
