@using BusinessAnalytics.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav flex-row align-items-center gap-3 mb-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link fw-semibold d-flex align-items-center gap-2"
               asp-controller="Account" asp-action="Profile"
               style="color: var(--text-main); text-decoration: none; padding: 6px 14px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04); transition: all 0.3s;"
               onmouseover="this.style.borderColor='rgba(0,255,136,0.4)';this.style.color='var(--neon-green)'"
               onmouseout="this.style.borderColor='rgba(255,255,255,0.08)';this.style.color='var(--text-main)'">
                <i class="bi bi-person-circle" style="color: var(--neon-green);"></i>
                Вітаю @User.Identity?.Name!
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="Account" asp-action="Register">Реєстрація</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark fw-semibold" asp-controller="Account" asp-action="Login">Вхід</a>
        </li>
    }
</ul>
