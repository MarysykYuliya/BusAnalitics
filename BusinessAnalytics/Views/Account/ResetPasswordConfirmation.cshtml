@{
    ViewData["Title"] = "Пароль змінено";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5 text-center">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px; background: rgba(0,255,136,0.1); border: 2px solid var(--neon-green); box-shadow: 0 0 20px var(--neon-green-glow);">
                <i class="bi bi-check-lg" style="font-size: 2.5rem; color: var(--neon-green);"></i>
            </div>
            
            <h2 class="page-title mb-3">Пароль успішно змінено!</h2>
            <p class="text-muted mb-4">
                Ваш пароль було оновлено. Тепер ви можете увійти до системи з новим паролем.
            </p>
            
            <a asp-action="Login" class="btn-modern btn-modern-primary w-100 py-3">
                Увійти <i class="bi bi-box-arrow-in-right ms-2"></i>
            </a>
        </div>
    </div>
</div>
