@model BusinessAnalytics.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Скидання пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-muted mb-3 d-block" style="font-size: 3rem; color: var(--neon-green) !important; text-shadow: 0 0 15px var(--neon-green-glow);"></i>
                <h2 class="page-title mb-2">Новий пароль</h2>
                <p class="text-muted">Введіть ваш новий безпечний пароль нижче.</p>
            </div>
            
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />
                
                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label">Новий пароль</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Підтвердження пароля</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-modern btn-modern-primary w-100 py-3">
                    Зберегти пароль <i class="bi bi-check-lg ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
