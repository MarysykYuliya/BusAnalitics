@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5 text-center">
            <i class="bi bi-envelope-paper text-muted mb-4 d-block" style="font-size: 4rem; color: var(--neon-green) !important; text-shadow: 0 0 20px var(--neon-green-glow);"></i>
            <h2 class="page-title mb-3">Лист відправлено!</h2>
            <p class="text-muted mb-4">
                Якщо такий email зареєстрований в системі, ви отримаєте лист із посиланням для відновлення пароля.
            </p>
            
            <a asp-action="Login" class="btn-modern d-inline-flex">
                <i class="bi bi-arrow-left me-2"></i> Повернутися до входу
            </a>
        </div>
    </div>
</div>
