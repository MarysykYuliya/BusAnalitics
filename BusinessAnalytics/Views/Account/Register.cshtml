@model BusinessAnalytics.Models.ViewModels.BusinessAnalytics.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus text-muted mb-3 d-block" style="font-size: 3rem; color: var(--neon-green) !important; text-shadow: 0 0 15px var(--neon-green-glow);"></i>
                <h2 class="page-title mb-2">Реєстрація</h2>
                <p class="text-muted">Створіть акаунт та почніть розвивати свій бізнес</p>
            </div>
            
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>
                
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Введіть ваш email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Пароль</label>
                    <input asp-for="Password" class="form-control" placeholder="Створіть надійний пароль" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Підтвердження пароля</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Введіть пароль ще раз" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-modern btn-modern-primary w-100 py-3 mb-4">
                    Зареєструватися <i class="bi bi-check-lg ms-2"></i>
                </button>
            </form>
            
            <div class="text-center pt-3" style="border-top: 1px solid rgba(255,255,255,0.05);">
                <p class="text-muted mb-0">
                    Вже є акаунт? 
                    <a asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--neon-green);">
                        Увійти
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
