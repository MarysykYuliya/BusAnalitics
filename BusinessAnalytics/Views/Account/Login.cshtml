@model BusinessAnalytics.Models.ViewModels.BusinessAnalytics.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Вхід";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-box-arrow-in-right text-muted mb-3 d-block" style="font-size: 3rem; color: var(--neon-green) !important; text-shadow: 0 0 15px var(--neon-green-glow);"></i>
                <h2 class="page-title mb-2">Вхід в систему</h2>
                <p class="text-muted">Увійдіть, щоб продовжити роботу з вашим бізнесом</p>
            </div>
            
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>
                
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Введіть ваш email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Пароль</label>
                    <input asp-for="Password" class="form-control" placeholder="Введіть пароль" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" style="background-color: rgba(0,0,0,0.3); border-color: rgba(255,255,255,0.2);" />
                        <label asp-for="RememberMe" class="form-check-label text-muted">Запам'ятати мене</label>
                    </div>
                    <a asp-action="ForgotPassword" class="text-decoration-none small hover-neon" style="color: var(--neon-green);">Забули пароль?</a>
                </div>

                <button type="submit" class="btn-modern btn-modern-primary w-100 py-3 mb-4">
                    Увійти <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </form>
            
            <div class="text-center pt-3" style="border-top: 1px solid rgba(255,255,255,0.05);">
                <p class="text-muted mb-0">
                    Немає акаунту? 
                    <a asp-action="Register" class="text-decoration-none fw-bold" style="color: var(--neon-green);">
                        Зареєструватися
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
