@model BusinessAnalytics.Models.ViewModels.ConfirmEmailChangeViewModel
@{
    ViewData["Title"] = "Підтвердження зміни email";
}

<div class="row justify-content-center" style="max-width: 480px; margin: 2rem auto;">
    <div class="glass-card p-5">
        <div class="text-center mb-4">
            <div style="font-size: 3rem; margin-bottom: 12px;">📧</div>
            <h4 class="fw-bold text-main">Підтвердіть нову пошту</h4>
            <p class="text-muted" style="font-size: 0.9rem;">
                Ми надіслали 6-значний код на<br>
                <strong style="color: var(--neon-green);">@Model.NewEmail</strong>
            </p>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

        <form asp-action="ConfirmEmailChange" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="NewEmail" value="@Model.NewEmail" />

            <div class="mb-4">
                <label class="form-label text-center d-block">Код підтвердження</label>
                <input type="text" name="Code" class="form-control text-center fw-bold"
                       placeholder="_ _ _ _ _ _"
                       maxlength="6"
                       style="font-size: 1.8rem; letter-spacing: 0.5rem; border-color: rgba(0,255,136,0.3);"
                       autofocus required />
            </div>

            <button type="submit" class="btn-modern btn-modern-primary w-100 py-3">
                <i class="bi bi-check-circle me-2"></i>Підтвердити зміну пошти
            </button>

            <div class="text-center mt-3">
                <a asp-action="Profile" asp-controller="Account" class="text-muted small" style="text-decoration: none;">
                    ← Повернутися до профілю
                </a>
            </div>
        </form>
    </div>
</div>
