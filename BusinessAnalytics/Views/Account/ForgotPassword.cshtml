@model BusinessAnalytics.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="bi bi-key text-muted mb-3 d-block" style="font-size: 3rem; color: var(--neon-green) !important; text-shadow: 0 0 15px var(--neon-green-glow);"></i>
                <h2 class="page-title mb-2">Відновлення пароля</h2>
                <p class="text-muted">Введіть email, і ми надішлемо вам посилання для створення нового пароля.</p>
            </div>
            
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Ваш Email</label>
                    <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-modern btn-modern-primary w-100 py-3 mb-4">
                    Надіслати посилання <i class="bi bi-send ms-2"></i>
                </button>
            </form>

            <div class="text-center pt-3" style="border-top: 1px solid rgba(255,255,255,0.05);">
                <a asp-action="Login" class="text-decoration-none text-muted hover-neon">
                    <i class="bi bi-arrow-left me-1"></i> Повернутися до входу
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
