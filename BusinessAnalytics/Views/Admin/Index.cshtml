@model List<BusinessAnalytics.Controllers.UserWithRoleViewModel>
@{
    ViewData["Title"] = "Керування користувачами";
    var roles = ViewBag.AllRoles as List<string>;
    var searchQuery = Context.Request.Query["search"].ToString();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-0 text-main fw-bold">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Керування доступом та ролями користувачів</p>
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="text" name="search" class="form-control" style="width: 250px;" placeholder="Пошук за email..." value="@searchQuery" />
            <button type="submit" class="btn-modern btn-modern-primary">
                <i class="bi bi-search"></i> Знайти
            </button>
        </form>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success bg-opacity-10 border-success text-success">
            <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
        </div>
    }

    <div class="card glass-card border-0">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-modern table-borderless align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Ім'я користувача</th>
                                <th>Роль</th>
                                <th>Дії</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="fw-medium text-main">
                                        <i class="bi bi-person-circle me-2 text-primary"></i>@user.Email
                                    </td>
                                    <td class="text-muted">@user.UserName</td>
                                    <td>
                                        <span class="badge badge-neon">@user.Role</span>
                                    </td>
                                    <td>
                                        <form asp-action="ChangeRole" method="post" class="d-flex gap-2 align-items-center">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRole" class="form-select form-select-sm" style="max-width:150px; background-color: rgba(0,0,0,0.2) !important;">
                                                @foreach (var role in roles)
                                                {
                                                    if (role == user.Role)
                                                    {
                                                        <option value="@role" selected>@role</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@role">@role</option>
                                                    }
                                                }
                                            </select>
                                            <button type="submit" class="btn-modern btn-modern-primary px-3 py-1" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">
                                                <i class="bi bi-check2"></i> Зберегти
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-search text-muted" style="font-size: 3rem; opacity: 0.5;"></i>
                    </div>
                    <h5 class="text-main fw-bold">Користувачів не знайдено</h5>
                    <p class="text-muted">За вашим запитом немає жодного результату.</p>
                </div>
            }
        </div>
    </div>
</div>
