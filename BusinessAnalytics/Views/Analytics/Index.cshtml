@using BusinessAnalytics.Models.DTO
@model List<BusinessOverviewDTO>
@{
    ViewData["Title"] = "Аналітика бізнесів";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-1">@ViewData["Title"]</h2>
        <p class="text-muted">Фінансовий стан та ключові показники ваших компаній</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var b in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 d-flex flex-column p-0 overflow-hidden shadow-sm">
                @if (!string.IsNullOrEmpty(b.ImageUrl))
                {
                    <div style="height: 160px; background-image: url('@b.ImageUrl'); background-size: cover; background-position: center; border-bottom: 1px solid rgba(0,0,0,0.05);"></div>
                }
                else
                {
                    <div style="height: 160px; background: linear-gradient(135deg, var(--primary), var(--dark-bg)); border-bottom: 1px solid rgba(0,0,0,0.05);" class="d-flex align-items-center justify-content-center">
                        <i class="bi bi-graph-up-arrow text-white" style="font-size: 4rem; opacity: 0.5;"></i>
                    </div>
                }
                
                <div class="card-body p-4 d-flex flex-column flex-grow-1">
                    <h5 class="fw-bold text-main mb-3">@b.Name</h5>
                    
                    <ul class="list-group list-group-flush mb-4 flex-grow-1 bg-transparent">
                        @foreach (var m in b.Metrics)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0 bg-transparent border-light align-items-center">
                                <span class="text-muted small">@m.Key</span>
                                <strong style="color: var(--neon-green);">@m.Value.ToString("0.00") ₴</strong>
                            </li>
                        }
                    </ul>
                    
                    <div class="mt-auto">
                        <a asp-action="Compare" asp-route-id="@b.BusinessId" class="btn-modern btn-modern-primary w-100 shadow-sm text-center">
                            <i class="bi bi-bar-chart-steps me-2"></i> Детальний аналіз
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="glass-card text-center py-5">
                <i class="bi bi-pie-chart text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                <h5 class="fw-bold text-main">Немає даних для аналітики</h5>
                <p class="text-muted">Додайте бізнес та транзакції, щоб побачити фінансові показники.</p>
                <a asp-controller="Business" asp-action="Create" class="btn-modern btn-modern-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Створити бізнес
                </a>
            </div>
        </div>
    }
</div>
